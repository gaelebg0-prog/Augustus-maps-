-static int view_to_grid_offset_lookup[VIEW_X_MAX][VIEW_Y_MAX];
+#include <stdlib.h>
+
+/*
+ * Table de correspondance vue -> offset de grille.
+ *
+ * Elle couvre toute la carte, donc ses dimensions dependent du pas de grille
+ * et non plus d'une constante : une carte plus grande que 162 tuiles exigeait
+ * sinon un debordement de tableau.
+ */
+static int *view_to_grid_offset_lookup;
+static int view_x_max = VIEW_X_MAX;
+static int view_y_max = VIEW_Y_MAX;
+static int lookup_dummy_cell = -1;
+
+static void ensure_view_lookup(void)
+{
+    int x_max = map_grid_stride + 3;
+    int y_max = map_grid_stride * 2 + 1;
+    if (view_to_grid_offset_lookup && x_max == view_x_max && y_max == view_y_max) {
+        return;
+    }
+    int *table = calloc((size_t) x_max * (size_t) y_max, sizeof(int));
+    if (!table) {
+        return;
+    }
+    free(view_to_grid_offset_lookup);
+    view_to_grid_offset_lookup = table;
+    view_x_max = x_max;
+    view_y_max = y_max;
+}
+
+static int *lookup_cell(int x, int y)
+{
+    ensure_view_lookup();
+    if (!view_to_grid_offset_lookup || x < 0 || y < 0 || x >= view_x_max || y >= view_y_max) {
+        lookup_dummy_cell = -1;
+        return &lookup_dummy_cell;
+    }
+    return &view_to_grid_offset_lookup[(size_t) x * (size_t) view_y_max + y];
+}
+
+#define LOOKUP(x, y) (*lookup_cell((x), (y)))
 
